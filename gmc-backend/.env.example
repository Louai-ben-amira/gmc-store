# ══════════════════════════════════════════════════════════════════════
#  GMC Store - Backend .env.example
#  Copy to .env and fill in real values. NEVER commit .env to git.
# ══════════════════════════════════════════════════════════════════════

# ── Django core ──────────────────────────────────────────────────────
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=CHANGE_ME_generate_a_real_key
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# ── Database (PostgreSQL) ────────────────────────────────────────────
# Option A: a single connection URL (e.g. Neon). If set, it takes priority
# over the DB_* vars below. Query params like sslmode/channel_binding are honored.
# DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require

# Option B: individual settings (used when DATABASE_URL is empty).
DB_NAME=gmc_store
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_HOST=127.0.0.1
DB_PORT=5432
# DB_SSLMODE=prefer   # set to "require" for managed Postgres

# ── Redis ────────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/0

# ── Media storage: Cloudflare R2 (S3-compatible) ─────────────────────
# Leave these empty to store uploads on the local filesystem (dev default).
# Set all four to store every upload in R2. The endpoint can be given
# directly, or derived automatically from R2_ACCOUNT_ID.
R2_ACCESS_KEY=CHANGE_ME
R2_SECRET_KEY=CHANGE_ME
R2_BUCKET_NAME=gmc-storage
R2_ACCOUNT_ID=CHANGE_ME          # 32-char account id (used to build the endpoint)
# R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com   # optional override
# Public bucket URL (r2.dev domain or a custom domain). If set, file URLs are
# served unsigned through it. If empty, URLs are signed (querystring auth).
R2_PUBLIC_URL=

# ── CORS / Frontend ──────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com

# ── Email (SMTP) ─────────────────────────────────────────────────────
EMAIL_HOST=smtp.mailgun.org
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=postmaster@mg.yourdomain.com
EMAIL_HOST_PASSWORD=CHANGE_ME
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# ── Telegram Bot Alerts ──────────────────────────────────────────────
# Create bot at t.me/BotFather → get token. Get chat ID at t.me/userinfobot
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_CHAT_ID=CHANGE_ME

# ── Social Auth ──────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
FACEBOOK_APP_ID=CHANGE_ME
FACEBOOK_APP_SECRET=CHANGE_ME

# ── Business config ──────────────────────────────────────────────────
LOW_STOCK_THRESHOLD=3

# ── Payment details shown to clients ────────────────────────────────
D17_PHONE=XX XXX XXX
BARIDIMOB_RIB=10 000 XXXX XXXX XXXX XXXX
DAHABIA_RIB=10 000 XXXX XXXX XXXX XXXX
BANK_RIB=08 XXX XXXX XXXX XXXX XXXX
PAYPAL_EMAIL=
