# ══════════════════════════════════════════════════════════════════════
#  GMC Store — Backend .env.example
#  Copy to .env and fill in real values. NEVER commit .env to git.
# ══════════════════════════════════════════════════════════════════════

# ── Django core ──────────────────────────────────────────────────────
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=CHANGE_ME_generate_a_real_key
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# ── Database (PostgreSQL) ────────────────────────────────────────────
DB_NAME=gmc_store
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_HOST=127.0.0.1
DB_PORT=5432

# ── Redis ────────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/0

# ── CORS / Frontend ──────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com

# ── Email (SMTP) ─────────────────────────────────────────────────────
EMAIL_HOST=smtp.mailgun.org
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=postmaster@mg.yourdomain.com
EMAIL_HOST_PASSWORD=CHANGE_ME
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# ── Telegram Bot Alerts ──────────────────────────────────────────────
# Create bot at t.me/BotFather → get token. Get chat ID at t.me/userinfobot
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_CHAT_ID=CHANGE_ME

# ── Social Auth ──────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
FACEBOOK_APP_ID=CHANGE_ME
FACEBOOK_APP_SECRET=CHANGE_ME

# ── Sentry error monitoring ──────────────────────────────────────────
# Sign up free at sentry.io → New Project → Django → copy DSN
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Business config ──────────────────────────────────────────────────
LOW_STOCK_THRESHOLD=3

# ── Payment details shown to clients ────────────────────────────────
D17_PHONE=XX XXX XXX
BARIDIMOB_RIB=10 000 XXXX XXXX XXXX XXXX
DAHABIA_RIB=10 000 XXXX XXXX XXXX XXXX
BANK_RIB=08 XXX XXXX XXXX XXXX XXXX
PAYPAL_EMAIL=
