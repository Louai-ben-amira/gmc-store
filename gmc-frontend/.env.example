# ══════════════════════════════════════════════════════════════════════
#  GMC Store — Frontend .env.example
#  Copy to .env and fill in real values. NEVER commit .env to git.
# ══════════════════════════════════════════════════════════════════════

# ── API URLs ─────────────────────────────────────────────────────────
VITE_API_URL=https://api.yourdomain.com/api
VITE_WS_URL=wss://api.yourdomain.com

# ── Sentry error monitoring ──────────────────────────────────────────
# Sign up free at sentry.io → New Project → React → copy DSN
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production

# ── Social Auth ──────────────────────────────────────────────────────
VITE_GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
VITE_FACEBOOK_APP_ID=CHANGE_ME
